# macOS
.DS_Store

# build output
build/
asr/.build/
__pycache__/
*.pyc

# local env / secrets (see .env.example)
.env
.env.*
!.env.example

# Cloudflare: wrangler caches and the per-account config (deploy.sh writes it from wrangler.example.toml)
.wrangler/
.dev.vars
cloud/node_modules/
cloud/wrangler.toml

# iPhone app: generated by phone/build.sh (Secrets.swift holds your Worker URL + upload token)
phone/Sources/Secrets.swift
phone/Sources/Info.plist
phone/LifelogPhone.xcodeproj/
phone/build/

# never commit recorded data (it lives in ~/Lifelog by default; these catch a LIFELOG_DIR pointed inside the repo)
*.db
*.db-wal
*.db-shm
Lifelog/
media/
reports/
