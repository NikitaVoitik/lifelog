# Environment variables Lifelog's scripts read. Nothing loads this file automatically: copy it to .env (gitignored),
# fill in what you need, and `set -a; source .env; set +a` before running a script. Everything is optional;
# most settings live in ~/Lifelog/config.json (see docs/config.example.json).

# --- everywhere -------------------------------------------------------------------------------------------------
# Where recordings, the database and config.json live (default ~/Lifelog). install.sh bakes it into the login item.
# LIFELOG_DIR=$HOME/Lifelog

# Which Claude Code login the timeline analysis uses (install.sh bakes it in; also settable as claudeConfigDir).
# CLAUDE_CONFIG_DIR=$HOME/.claude

# --- Mac app (build.sh, tools/signing-cert.sh) ------------------------------------------------------------------
# Sign with an existing identity instead of the self-signed "Lifelog Local Signing" one build.sh creates.
# LIFELOG_SIGN_IDENTITY=
# Name of the self-signed identity tools/signing-cert.sh creates / reuses.
# LIFELOG_SIGN_NAME=Lifelog Local Signing
# Run a pipeline checkout instead of the installed ~/Lifelog/bin/lifelog.py (development).
# LIFELOG_SCRIPT=/path/to/lifelog/pipeline/lifelog.py

# --- iPhone app (phone/build.sh) --------------------------------------------------------------------------------
# Your Apple developer team id (or "phoneTeam" in config.json). Required to install on a device.
# LIFELOG_TEAM=ABCDE12345
# Bundle id (or "phoneBundleId"); default lifelog.<team>.phone. Changing it installs a separate app.
# LIFELOG_BUNDLE_ID=
# Worker URL and the phone's upload-only token (default: cloudUrl / phoneToken from config.json, written by cloud/deploy.sh)
# LIFELOG_CLOUD_URL=https://lifelog.<your-subdomain>.workers.dev
# LIFELOG_PHONE_TOKEN=
# Device id of the iPhone to install on, if more than one is paired (xcrun devicectl list devices).
# LIFELOG_IPHONE=

# --- deep analysis (analysis/ll.py) -----------------------------------------------------------------------------
# Worker URL and the analyst token (read everything, write only analysis results). Default: cloudUrl / analystToken.
# LIFELOG_URL=https://lifelog.<your-subdomain>.workers.dev
# LIFELOG_TOKEN=
# Which laptop's data to analyze (deviceId in config.json, default "mac").
# LIFELOG_DEVICE=mac
# Download cache for raw hours and screenshots.
# LIFELOG_CACHE=/tmp/lifelog-cache
# How far back `ll.py status` looks for unanalyzed data.
# LIFELOG_HORIZON_HOURS=30
