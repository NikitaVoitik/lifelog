{
  "_comment": "Example ~/Lifelog/config.json with the defaults. The app and the CLI create the file and fill in missing keys; cloud/deploy.sh adds cloudUrl and the three tokens. Keep the real file private (chmod 600): its tokens grant access to everything you recorded.",

  "screenshotFPS": 1,
  "screenshotMaxWidth": 1920,
  "jpegQuality": 0.55,
  "ocr": true,
  "ocrInterval": 10,
  "recordMic": true,
  "preferBuiltInMic": true,
  "recordSystemAudio": true,
  "recordAudioWhenLocked": true,
  "audioChunkSeconds": 300,
  "excludedBundleIDs": ["com.1password.1password", "com.agilebits.onepassword7", "com.bitwarden.desktop",
                        "com.apple.keychainaccess", "com.apple.Passwords"],
  "browserAppleScriptFallback": true,
  "processEveryMinutes": 30,
  "syncEveryMinutes": 10,

  "transcriber": "fluidaudio",
  "diarize": true,
  "voiceMatchThreshold": 0.72,
  "transcribeLanguage": "auto",
  "micSpeechThresholdDb": -50,
  "sysSoundThresholdDb": -60,
  "idleThresholdSeconds": 60,
  "absenceMinMinutes": 45,
  "analysisModel": "sonnet",
  "summaryModel": "sonnet",
  "claudeConfigDir": "",
  "aboutMe": "",
  "agentLogHosts": [],
  "agentLogDelta": true,
  "agentLogBackfillDays": 2,

  "deviceId": "mac",
  "r2Bucket": "lifelog-media",
  "cloudUrl": "",
  "cloudToken": "",
  "analystToken": "",
  "phoneToken": "",
  "localMediaKeepDays": 3,
  "syncOnExpensiveNetwork": false,
  "bundleMaxBytes": 200000000,
  "dbBackupEveryDays": 1,
  "dbBackupsToKeep": 7,

  "phoneDeviceId": "iphone",
  "phoneTeam": "",
  "phoneBundleId": ""
}
